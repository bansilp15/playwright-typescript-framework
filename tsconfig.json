 {
    "compilerOptions": {
        "target": "esnext",
        "module": "commonjs",
        "strict": true,
        "resolveJsonModule": true,
        "esModuleInterop": true,
        "skipLibCheck": true,
        "forceConsistentCasingInFileNames": true,
        "types": ["node"],
        "rootDir": ".",
        "outDir": "dist"
    },
    "include": ["src", "playwright.config.ts"]
 }
